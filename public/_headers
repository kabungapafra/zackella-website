# Cache rules for Cloudflare Pages, which reads this file from the deploy root.
#
# Every matching rule is APPENDED, not overridden, so two rules that both set
# Cache-Control leave one header holding two max-ages and the first one wins.
# There is deliberately no catch-all here: HTML keeps the Pages default of
# revalidating on every request, and each rule below owns paths no other rule
# matches.

# Next writes a content hash into every filename here, so the URL changes
# whenever the bytes do and these can be held forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Each generated variant carries a hash of its own bytes in its name, so a
# changed photograph arrives under a new URL. Same reasoning as above.
/opt/*
  Cache-Control: public, max-age=31536000, immutable

# The original photographs and the reel keep plain names, so they get a month
# and a replacement ages out rather than sticking.
/*.jpg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.mp4
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
